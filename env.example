# Meta Marketing API
# System User access token with ads_read on every client account below.
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# Multi-client config: one entry per Meta ad account this dashboard should track.
# Pre-filled with your agency's current clients (Meta only for now) — edit as clients change.
# Note: Quantum Key Institute's ad account is currently IN_GRACE_PERIOD in Meta — worth checking.
CLIENTS=[{"id":"aie","name":"AIE","metaAdAccountId":"act_20797246"},{"id":"oakberry","name":"Oakberry","metaAdAccountId":"act_2784870228408236"},{"id":"sydney-premium-detailing","name":"Sydney Premium Detailing","metaAdAccountId":"act_672206165220490"},{"id":"killer-image","name":"Killer Image","metaAdAccountId":"act_973590704397948"},{"id":"quantum-key-institute","name":"Quantum Key Institute","metaAdAccountId":"act_1604914593699249"},{"id":"basyqs","name":"Basyqs","metaAdAccountId":"act_934306192325037"},{"id":"tailored-home","name":"Tailored Home","metaAdAccountId":"act_411795654270783"},{"id":"fresh-patch","name":"Fresh Patch","metaAdAccountId":"act_531414987044002"},{"id":"pat-mesiti","name":"Pat Mesiti","metaAdAccountId":"act_1036659904626382"},{"id":"fast-client-formula-usa","name":"Fast Client Formula (USA)","metaAdAccountId":"act_776452816045924"},{"id":"fast-client-formula-au","name":"Fast Client Formula (AU)","metaAdAccountId":"act_1897396998086876"}]

# Claude API (for insights/flags/optimizations)
ANTHROPIC_API_KEY=

# Polling interval in seconds for the live metrics feed
METRICS_POLL_INTERVAL_SECONDS=300

# --- Daily email health check ---
# Gmail SMTP via an App Password (myaccount.google.com/apppasswords), or swap lib/email.ts for another provider.
EMAIL_FROM=
EMAIL_TO=joey.gattellari7@gmail.com
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Shared secret required as ?secret= or Authorization: Bearer <secret> on /api/daily-report,
# so only your scheduler (e.g. Vercel Cron) can trigger it.
CRON_SECRET=
