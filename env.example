# Claude API (for AI insights)
ANTHROPIC_API_KEY=

# How often to refresh live metrics (seconds, default 300 = 5 min)
METRICS_POLL_INTERVAL_SECONDS=300

# Meta API version override (optional)
META_API_VERSION=v21.0

# ─── Per-client credentials ───────────────────────────────────────────────────
# Replace {SLUG} with your client's slug (must match what's in src/lib/clients.ts)
# e.g. if slug is "acme" → CLIENT_ACME_META_ACCESS_TOKEN

# Meta Ads
CLIENT_{SLUG}_META_ACCESS_TOKEN=
CLIENT_{SLUG}_META_AD_ACCOUNT_ID=act_XXXXXXXXXX

# TikTok Ads
CLIENT_{SLUG}_TIKTOK_ACCESS_TOKEN=
CLIENT_{SLUG}_TIKTOK_ADVERTISER_ID=

# Google Ads
CLIENT_{SLUG}_GOOGLE_DEVELOPER_TOKEN=
CLIENT_{SLUG}_GOOGLE_CUSTOMER_ID=
CLIENT_{SLUG}_GOOGLE_ACCESS_TOKEN=

# HYROS
CLIENT_{SLUG}_HYROS_API_KEY=
